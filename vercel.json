{
  "outputDirectory": ".",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/recur",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/remind",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/team-tasks.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"team-tasks.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api/manifest"
    },
    {
      "source": "/team-tasks.apk",
      "destination": "/public/team-tasks.apk"
    },
    {
      "source": "/apk",
      "destination": "/public/team-tasks.apk"
    },
    {
      "source": "/apk/download",
      "destination": "/public/team-tasks.apk"
    }
  ]
}
